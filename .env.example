# MySQL connection (create the database and user before starting the server).
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="alldisplay"
MYSQL_PASSWORD="REPLACE_WITH_A_STRONG_DATABASE_PASSWORD"
MYSQL_DATABASE="alldisplay"
MYSQL_SSL="false"

# Admin password and signing secret stay on the server; never use a VITE_ prefix.
ADMIN_PASSWORD="REPLACE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD"
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
PORT="3001"
