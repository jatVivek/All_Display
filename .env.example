# Live Environment Base URL
SITE_URL="https://alldisplay.co.in"
VITE_SITE_URL="https://alldisplay.co.in"
BASE_URL="https://alldisplay.co.in"
VITE_BASE_URL="https://alldisplay.co.in"

# Live MySQL Database Configuration (Cloud: TiDB, PlanetScale, AWS RDS, Railway, Aiven, etc.)
# Option 1: Complete Connection URI (Recommended for cloud hosting)
DATABASE_URL="REPLACE_WITH_YOUR_MANAGED_MYSQL_CONNECTION_URI"

# Option 2: Individual Environment Variables
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="alldisplay"
MYSQL_PASSWORD="REPLACE_WITH_A_STRONG_DATABASE_PASSWORD"
MYSQL_DATABASE="alldisplay"
MYSQL_SSL="true"
MYSQL_SSL_REJECT_UNAUTHORIZED="false"

# Admin & Session Authentication
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS"
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
PORT="3001"
